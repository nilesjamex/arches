# Copy this file to .env at the repository root and replace each value.
# Never commit .env. Keep the single quotes, because generated keys can contain $ or #.

# Password for the "postgres" database user.
Postgres_Password='change-me'

# Password for the Elasticsearch "elastic" user. To set a new one, run this from the
# Elasticsearch folder: bin\elasticsearch-reset-password.bat -u elastic -i
Elastic_Password='change-me'

# Generate a value with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
Django_Secret_Key='change-me'
